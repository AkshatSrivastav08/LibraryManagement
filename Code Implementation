#include <iostream>
#include <fstream>
#include <string>
#include <iomanip>

using namespace std;

class Book {
public:
    int bookID;
    string title, author;
    bool isIssued;

    void input() {
        cout << "Enter Book ID: "; cin >> bookID;
        cin.ignore();
        cout << "Enter Title: "; getline(cin, title);
        cout << "Enter Author: "; getline(cin, author);
        isIssued = false;
    }

    void display() const {
        cout << left << setw(10) << bookID
             << setw(30) << title
             << setw(20) << author
             << setw(10) << (isIssued ? "Issued" : "Available") << endl;
    }

    int getID() const { return bookID; }
};

void addBook() {
    ofstream file("books.dat", ios::binary | ios::app);
    Book b;
    b.input();
    file.write(reinterpret_cast<char*>(&b), sizeof(b));
    file.close();
    cout << "Book added successfully!\n";
}

void displayBooks() {
    ifstream file("books.dat", ios::binary);
    Book b;
    cout << left << setw(10) << "ID"
         << setw(30) << "Title"
         << setw(20) << "Author"
         << setw(10) << "Status" << endl;
    cout << "-------------------------------------------------------------\n";
    while (file.read(reinterpret_cast<char*>(&b), sizeof(b))) {
        b.display();
    }
    file.close();
}

void searchBook(int id) {
    ifstream file("books.dat", ios::binary);
    Book b;
    bool found = false;
    while (file.read(reinterpret_cast<char*>(&b), sizeof(b))) {
        if (b.getID() == id) {
            cout << "Book Found:\n";
            b.display();
            found = true;
            break;
        }
    }
    file.close();
    if (!found)
        cout << "Book not found.\n";
}

void updateBook(int id) {
    fstream file("books.dat", ios::binary | ios::in | ios::out);
    Book b;
    bool found = false;
    while (!found && file.read(reinterpret_cast<char*>(&b), sizeof(b))) {
        if (b.getID() == id) {
            cout << "Enter new details:\n";
            b.input();
            file.seekp(-static_cast<int>(sizeof(b)), ios::cur);
            file.write(reinterpret_cast<char*>(&b), sizeof(b));
            cout << "Book updated.\n";
            found = true;
        }
    }
    file.close();
    if (!found)
        cout << "Book not found.\n";
}

void deleteBook(int id) {
    ifstream inFile("books.dat", ios::binary);
    ofstream outFile("temp.dat", ios::binary);
    Book b;
    bool found = false;
    while (inFile.read(reinterpret_cast<char*>(&b), sizeof(b))) {
        if (b.getID() == id) {
            found = true;
            continue;
        }
        outFile.write(reinterpret_cast<char*>(&b), sizeof(b));
    }
    inFile.close();
    outFile.close();
    remove("books.dat");
    rename("temp.dat", "books.dat");
    if (found)
        cout << "Book deleted.\n";
    else
        cout << "Book not found.\n";
}

void issueBook(int id) {
    fstream file("books.dat", ios::binary | ios::in | ios::out);
    Book b;
    bool found = false;
    while (!found && file.read(reinterpret_cast<char*>(&b), sizeof(b))) {
        if (b.getID() == id) {
            if (b.isIssued)
                cout << "Book already issued.\n";
            else {
                b.isIssued = true;
                file.seekp(-static_cast<int>(sizeof(b)), ios::cur);
                file.write(reinterpret_cast<char*>(&b), sizeof(b));
                cout << "Book issued successfully.\n";
            }
            found = true;
        }
    }
    file.close();
    if (!found)
        cout << "Book not found.\n";
}

void returnBook(int id) {
    fstream file("books.dat", ios::binary | ios::in | ios::out);
    Book b;
    bool found = false;
    while (!found && file.read(reinterpret_cast<char*>(&b), sizeof(b))) {
        if (b.getID() == id) {
            if (!b.isIssued)
                cout << "Book is not issued.\n";
            else {
                b.isIssued = false;
                file.seekp(-static_cast<int>(sizeof(b)), ios::cur);
                file.write(reinterpret_cast<char*>(&b), sizeof(b));
                cout << "Book returned successfully.\n";
            }
            found = true;
        }
    }
    file.close();
    if (!found)
        cout << "Book not found.\n";
}

int main() {
    int choice, id;
    do {
        cout << "\n--- Library Management System ---\n";
        cout << "1. Add Book\n2. Display All Books\n3. Search Book\n4. Update Book\n";
        cout << "5. Delete Book\n6. Issue Book\n7. Return Book\n0. Exit\n";
        cout << "Enter your choice: ";
        cin >> choice;

        switch (choice) {
        case 1: addBook(); break;
        case 2: displayBooks(); break;
        case 3:
            cout << "Enter Book ID to search: "; cin >> id;
            searchBook(id); break;
        case 4:
            cout << "Enter Book ID to update: "; cin >> id;
            updateBook(id); break;
        case 5:
            cout << "Enter Book ID to delete: "; cin >> id;
            deleteBook(id); break;
        case 6:
            cout << "Enter Book ID to issue: "; cin >> id;
            issueBook(id); break;
        case 7:
            cout << "Enter Book ID to return: "; cin >> id;
            returnBook(id); break;
        case 0:
            cout << "Exiting...\n"; break;
        default:
            cout << "Invalid choice. Try again.\n";
        }
    } while (choice != 0);

    return 0;
}
